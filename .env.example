# The app's secrets. Copy this file to .env (next to this file) and fill it in. .env is in .gitignore, so it is
# never committed. The server reads it at startup however it runs: `dotnet run` / `dotnet watch run` (it looks in
# the current folder and each parent folder), Docker (`env_file: .env`), or a server. A real environment variable
# with the same name wins over the file. Write each comment on its own line, not after a value. Restart the server after changing it.
#
# Only secrets belong here. Everything else (the chat API address and model, the Ollama address, the prompt, ...)
# is on the Settings page → AI assistant, and applies to the next message without a restart.

# The admin login (not a row in the database). A double underscore means a section: Admin__Password is Admin:Password.
Admin__Username=admin
Admin__Password=change-me

# Signs the login tokens. At least 32 characters. Generate one with: openssl rand -base64 48
Jwt__Key=change-me-to-a-long-random-secret-of-at-least-32-characters

# The key for the online chat service set in Settings → AI assistant → Chat API address (Gemini, Grok, Groq,
# OpenRouter, Mistral, Cerebras, ...). The Settings page lists each service's address, a model and where to get a
# key. Leave it empty when the chat runs on Ollama. Restart the server after changing it.
AI_API_KEY=

# The key for an online embedding service set in Settings → AI assistant → Embedding API address (Gemini, Mistral,
# OpenAI, ...). Leave it empty to use AI_API_KEY (when chat and embeddings use the same service) or when the
# embeddings run on Ollama.
EMBEDDING_API_KEY=
