# Copy this file to .env and set the values. .env is NOT committed (it is in .gitignore).
# One file for both ways of running the API: `dotnet run` reads it at startup (Development only), and Docker gets it
# with `docker run --env-file .env`. On a server (Render, ...) set the same names as environment variables. The names
# are the .NET configuration names: a double underscore is a colon, so Admin__Password is the setting Admin:Password.
# Write each comment on its own line, not after a value. Restart the server after changing it.

# The admin login (not a row in the database).
Admin__Username=admin
Admin__Password=change-me

# Signs the login token. At least 32 characters. Generate one with: openssl rand -base64 48
Jwt__Key=change-me-to-a-long-random-secret-of-at-least-32-characters

# The key of each online AI service you use, for the chat model and for the embedding model. Each key has its own
# variable: the Settings page saves only the NAME of the variable (for example GEMINI_API_KEY), never the key. A name
# must end in API_KEY. Leave a key empty when you don't use that service. Ollama needs no key.
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_KEY=
# The Cloudflare account id: <ACCOUNT_ID> in the address of Cloudflare Workers AI is filled in from it (needed with CLOUDFLARE_API_KEY).
CLOUDFLARE_ACCOUNT_ID=
OPENAI_API_KEY=

# Optional: the starting chat and embedding models of a NEW database (and what "Load default AI assistant data"
# saves). Without them the chat model is Groq and no embedding model is selected: an admin chooses one on the Settings
# page (Next model, or View models and Select). For a service on the Settings page the address is enough: its model and key name are filled in.
# AiDefaults__ChatBaseUrl=http://localhost:11434
# AiDefaults__ChatModel=qwen2.5:7b
# AiDefaults__EmbeddingBaseUrl=http://localhost:11434
# AiDefaults__EmbeddingModel=nomic-embed-text

# Optional, for a server whose disk is wiped (Render's free plan): keep a copy of the SQLite database in a bucket (Backblaze B2,
# Cloudflare R2 or any S3-compatible storage) and restore it at every start. See the README ("Keep the data on Render's free
# plan"). Docker image only. Use a bucket of its own for this app.
# LITESTREAM_ENABLED=true
# LITESTREAM_BUCKET=
# LITESTREAM_ENDPOINT=https://s3.<region>.backblazeb2.com   (R2: https://<account id>.r2.cloudflarestorage.com)
# LITESTREAM_REGION=<region of a B2 endpoint, for example us-west-004; leave out for R2>
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# The address of the client when it is on another site (Vercel), so the browser may call this API. Several are
# separated by commas.
# Cors__AllowedOrigins=https://myhospitalai.example.com
