{
  // How much the server writes to its log. "Microsoft.AspNetCore" is set to "Warning" so the framework's own
  // messages stay quiet; each request is still logged with its time (RequestTiming).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // The host names the server answers to. "*" means any.
  "AllowedHosts": "*",

  // The database: a SQLite file, created and updated by itself at startup. The path is relative to where the API runs
  // (in Docker it is /app/data, which is the volume).
  "ConnectionStrings": {
    "Default": "Data Source=data/myhospitalai.db"
  },

  // The login token (JWT). Issuer and Audience are written into the token and checked when it comes back;
  // ExpiresMinutes is how long a login lasts. The signing key is NOT here on purpose: it comes from the .env file
  // (Jwt__Key), and the server refuses to start without it.
  "Jwt": {
    "Issuer": "MyHospitalAI",
    "Audience": "MyHospitalAI.Client",
    "ExpiresMinutes": 60
  },

  // The admin login is not a row in the database and not in this file: Admin__Username and Admin__Password come
  // from the .env file, and the server refuses to start without them.

  // Which web addresses may call the API from a browser (CORS), separated by commas, for example
  // "https://myhospitalai.example.com". Needed only when the client is hosted on another address, such as Vercel.
  // Empty means CORS is off, which is right when the page and the API share an address (the Vite dev server).
  // Environment variable: Cors__AllowedOrigins
  "Cors": {
    "AllowedOrigins": ""
  }

  // The keys of the online AI services (GEMINI_API_KEY, GROQ_API_KEY, ...) are NOT in this file: they go in the .env
  // file, so they never end up in git. Nothing else about the AI assistant is here either: the models, the prompt and
  // how the knowledge is searched are settings in the database, changed on the Settings page (AI assistant tab).
}
